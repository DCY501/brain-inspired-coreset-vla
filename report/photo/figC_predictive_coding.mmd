%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#e8f4f8', 'primaryTextColor': '#333', 'primaryBorderColor': '#3498db', 'lineColor': '#666', 'secondaryColor': '#f0f0f0', 'tertiaryColor': '#fff'}, 'flowchart': { 'htmlLabels': true, 'curve': 'basis' }}}%%
flowchart TD
    A["输入: 训练集动作序列 a_1, a_2, ..., a_T"] --> B["按 episode 分组"]
    B --> C["对每个 episode 逐帧滑动窗口 (window=w)"]
    C --> D["取前 w 帧动作作为特征: X = [a_{t-w}, ..., a_{t-1}]"]
    D --> E["最小二乘线性回归预测当前帧: a_hat_t = X·w"]
    E --> F["计算预测残差: r_t = ||a_t - a_hat_t||_2"]
    F --> G{"该 episode 所有帧残差计算完毕?"}
    G -->|否, 继续下一帧| C
    G -->|是| H["全局按残差排序: 残差大 = 难预测 = 信息丰富 = 保留"]
    H --> I["取 Top-K 核心集 (K = 20% x N_train)"]
    I --> J["输出: 核心集索引"]

    style A fill:#e8f4f8,stroke:#3498db,stroke-width:2px
    style B fill:#f5eef8,stroke:#9b59b6,stroke-width:1.5px
    style C fill:#eafaf1,stroke:#2ecc71,stroke-width:2px
    style D fill:#eafaf1,stroke:#2ecc71,stroke-width:1.5px
    style E fill:#eafaf1,stroke:#2ecc71,stroke-width:1.5px
    style F fill:#fef9e7,stroke:#f39c12,stroke-width:2px
    style G fill:#eafaf1,stroke:#2ecc71,stroke-width:2px
    style H fill:#eafaf1,stroke:#2ecc71,stroke-width:2px
    style I fill:#eafaf1,stroke:#2ecc71,stroke-width:2px
    style J fill:#d5f5e3,stroke:#2ecc71,stroke-width:3px
