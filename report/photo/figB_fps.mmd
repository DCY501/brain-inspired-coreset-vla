flowchart TD
    A["输入：768d CLIP 视觉特征<br/>（16,000 帧训练数据）"] --> B["标准 FPS：贪心选最远点<br/>→ 1,600 帧候选核心集"]
    B --> C["k-NN 局部密度估计<br/>（k=6，欧氏距离）"]
    C --> D["识别孤立点：找出 15% 最稀疏帧<br/>→ 240 帧疑似噪声"]

    subgraph 密度过滤修复["密度过滤修复"]
        D --> E["用全局最密集的典型帧替换"]
        E --> F1["替换前密度<br/>0.055 ~ 0.19"]
        E --> F2["替换后密度<br/>0.0026 ~ 0.0041"]
    end

    F1 --> G["输出：1,600 帧核心集<br/>（远且不孤立 = 最优）"]
    F2 --> G

    style A fill:#2c3e50,stroke:#000,color:#fff
    style B fill:#3498db,stroke:#000,color:#fff
